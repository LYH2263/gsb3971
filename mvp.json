{
  "project_name": "neusoft-elderly-care-mvp",
  "project_name_cn": "雾屿潮间带研学营运营台（MVP）",
  "description": "面向潮间带生态研学营的基础运营台，提供用户注册登录、学员档案与入营/结营/离营外出登记、营房铺位设置与占用管理、营期配餐周菜单与学员定制、带教档位与辅导记录录入等核心能力，采用 Vue3+Element-Plus 前端与 Spring Boot+MyBatis-Plus 后端，MySQL 持久化，前后端分离通过 REST API 交互。",
  "target_users": [
    "研学营管理员（维护用户、营房铺位、基础配置）",
    "营务前台（学员建档、入营/结营/离营外出登记、铺位分配）",
    "带队导师（辅导记录填写）",
    "营养/后勤人员（周菜单维护、学员配餐定制）"
  ],
  "tech_stack": {
    "frontend": "Vue 3 + Vite + Vue Router + Pinia + Element-Plus + Axios",
    "backend": "Java 17 + Spring Boot 3 + Spring MVC + Spring Security(JWT) + MyBatis-Plus + Hibernate Validator",
    "database": "MySQL 8.x",
    "reasoning": "Vue3+Element-Plus 适合快速搭建管理后台；Spring Boot 提供成熟的分层与安全体系；MyBatis-Plus 提升 CRUD 开发效率；JWT 便于前后端分离；MySQL 满足结构化业务数据存储与查询。"
  },
  "core_features": [
    {
      "module": "账号与营务账号",
      "features": [
        "公民用户注册：手机号唯一、密码加密存储、填写姓名/年龄/性别",
        "手机号+密码登录获取 JWT，并在前端持久化会话",
        "基础用户列表与启用/停用（管理员）"
      ],
      "priority": "P0"
    },
    {
      "module": "客户档案与出入管理",
      "features": [
        "客户建档：基本信息、紧急联系人（可选）、备注",
        "入营登记：设置入营日期、分配铺位、状态变更为“在营”",
        "结营/离营外出登记：记录日期与原因（简化），状态变更"
      ],
      "priority": "P0"
    },
    {
      "module": "营房与铺位管理",
      "features": [
        "房间维护：楼层/房间号/类型（可选）",
        "铺位维护：铺位编号、所属营房、状态（空闲/占用/停用）",
        "铺位分配校验：同一铺位同一时间仅允许一个在营学员占用"
      ],
      "priority": "P0"
    },
    {
      "module": "营期配餐（周菜单与客户定制）",
      "features": [
        "配餐日历：维护每周菜单（按周起始日期+周一到周日）",
        "学员配餐定制：为客户选择餐型/忌口备注/额外要求",
        "按客户查看本周菜单与其定制信息汇总"
      ],
      "priority": "P1"
    },
    {
      "module": "带教辅导（级别与记录）",
      "features": [
        "带教档位维护：级别名称与描述（如：一级/二级）",
        "辅导内容（项目）简化为自由文本记录项",
        "辅导记录：选择客户、记录日期、辅导内容、执行人"
      ],
      "priority": "P1"
    }
  ],
  "pages": [
    {
      "path": "/login",
      "name": "登录/注册",
      "description": "用户使用手机号注册并登录，获取系统访问权限。",
      "key_elements": [
        "登录表单：手机号、密码",
        "注册表单：手机号、密码、真实姓名、年龄、性别",
        "表单校验：必填、手机号格式、密码长度",
        "登录成功跳转与错误提示"
      ]
    },
    {
      "path": "/customers",
      "name": "学员档案",
      "description": "学员建档、入营/结营/离营外出登记与铺位分配的核心操作页面。",
      "key_elements": [
        "学员列表：姓名、手机号、状态、铺位、带教档位（可选）、操作",
        "客户新建/编辑弹窗",
        "入营登记弹窗：入营日期、选择铺位",
        "结营/离营外出登记弹窗：日期、原因",
        "筛选：状态/关键词"
      ]
    },
    {
      "path": "/rooms",
      "name": "营房铺位管理",
      "description": "维护营房与铺位基础数据，并查看铺位占用情况。",
      "key_elements": [
        "营房列表：营房号、楼层、铺位数、操作",
        "铺位列表（按房间展开）：铺位编号、状态当前学员（若占用）",
        "新增/编辑营房、铺位弹窗",
        "铺位停用/启用操作"
      ]
    },
    {
      "path": "/meals",
      "name": "营期配餐",
      "description": "维护每周菜单并为学员记录配餐定制信息。",
      "key_elements": [
        "周选择器（周起始日期）与周菜单编辑表（周一至周日）",
        "学员选择与配餐定制表单：餐型/忌口/备注",
        "保存与查看本周客户定制汇总列表"
      ]
    },
    {
      "path": "/care",
      "name": "带教辅导",
      "description": "维护带教档位并记录学员辅导执行情况。",
      "key_elements": [
        "带教档位列表：名称、描述、启用状态",
        "辅导记录列表：客户、日期、内容、执行人",
        "新增辅导记录弹窗：客户、日期、内容",
        "按客户/日期筛选"
      ]
    }
  ],
